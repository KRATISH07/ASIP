{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://asip-backend.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs"
    }
  }
}
